# ==============================================================================
# GEV-VERIFY / SATYAM Platform Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local before starting the application:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION (LOCAL & PRODUCTION)
# ------------------------------------------------------------------------------
# PORT: Application server port (Frontend & Express API)
PORT=3000

# HOST: Network interface binding
HOST=0.0.0.0

# NODE_ENV: Runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# LOG_LEVEL: Application logging verbosity ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace' | 'silent')
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# JWT_SECRET: Secret key used to sign and verify role-based session tokens
# [REQUIRED FOR PRODUCTION / OPTIONAL FOR LOCAL DEV]
JWT_SECRET=replace_with_a_long_random_secret

# ------------------------------------------------------------------------------
# 3. AI & DOCUMENT INTELLIGENCE (OPTIONAL)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key for multimodal statutory document extraction
# and citation-grounded advisory formulation.
# [OPTIONAL]: If not provided, the platform automatically utilizes its built-in
# deterministic rule evaluation engine and structured statutory parser fallback.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT:
# The active local persistence layer automatically uses an embedded SQLite database
# stored at `data/gev_verify.sqlite`. No external database configuration is required.

# PRODUCTION DEPLOYMENT (CONTAINER / DOCKER COMPOSE):
# DATABASE_URL: PostgreSQL connection URI with pgvector extension support
DATABASE_URL=postgresql://gev_admin:replace_with_secure_postgres_password@localhost:5432/gev_verify?schema=public

# POSTGRES_USER: PostgreSQL database user for Docker Compose
POSTGRES_USER=gev_admin

# POSTGRES_PASSWORD: PostgreSQL password for Docker Compose
POSTGRES_PASSWORD=replace_with_secure_postgres_password

# POSTGRES_DB: PostgreSQL database name for Docker Compose
POSTGRES_DB=gev_verify

# ------------------------------------------------------------------------------
# 5. EXTERNAL STORAGE & CLOUD INTEGRATIONS (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
# REDIS_URL: Distributed cache and job queue connection string
REDIS_URL=redis://localhost:6379

# GCS_BUCKET_NAME: Google Cloud Storage bucket for long-term document archiving
GCS_BUCKET_NAME=